@page
@model ListsModel

@{
    ViewData["Title"] = "Lists";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <p>Create a list, add an item, query it and delete it again via the Lists API.</p>
        <form method="post">
            <button type="submit" class="btn btn-primary">Run Lists demo</button>
        </form>
        @if (!string.IsNullOrEmpty(Model.Status))
        {
            <pre class="mt-3">@Model.Status</pre>
        }
    </div>
</div>
